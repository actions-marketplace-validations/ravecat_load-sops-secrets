{
  "name": "load-sops-secrets",
  "description": "Load secrets from a SOPS-encrypted JSON file as masked step outputs",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --minify --license licenses.txt",
    "debug": "node scripts/debug.js",
    "predebug:workflow": "npm run build",
    "debug:workflow": "act workflow_dispatch --local-repository \"ravecat/load-sops-secrets@local=$PWD\"",
    "test": "node --test tests/*.test.ts",
    "test:integration": "vitest run",
    "lint:workflows": "actionlint .github/workflows/*.yml tests/integration/workflow.yml",
    "lint:docs": "markdownlint-cli2",
    "check": "npm run typecheck && npm run build && npm run lint && npm test && npm run test:integration",
    "release": "semantic-release",
    "lint:js": "eslint .",
    "lint": "npm run lint:workflows && npm run lint:js && npm run lint:docs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/io": "3.0.2",
    "@actions/tool-cache": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.13.3",
    "@typescript-eslint/parser": "8.70.0",
    "@vercel/ncc": "0.45.0",
    "conventional-changelog-conventionalcommits": "9.3.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
